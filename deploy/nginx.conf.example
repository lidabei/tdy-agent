# Nginx 反代示例：放到 /etc/nginx/sites-available/tdy-manager
# 启用: ln -s /etc/nginx/sites-available/tdy-manager /etc/nginx/sites-enabled/
#       nginx -t && systemctl reload nginx

upstream tdy_backend {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name your-domain.com;   # 改成域名或服务器 IP

    client_max_body_size 32m;

    location / {
        proxy_pass http://tdy_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

